# Copier ce fichier en .env pour un lancement local sans Docker.
IK_ENVIRONMENT=development
IK_DATABASE_URL=sqlite:///./dev.db
# En production : une longue valeur aléatoire, par exemple `openssl rand -hex 32`.
IK_SECRET_KEY=cle-de-developpement-a-remplacer-avant-la-production
IK_ACCESS_TOKEN_MINUTES=720
IK_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
IK_AUTO_CREATE_TABLES=true
